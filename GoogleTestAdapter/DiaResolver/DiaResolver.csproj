  </PropertyGroup>
  <PropertyGroup Condition="'$(RealSign)' == 'True'">
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RealSign)' != 'True'">
    <SignAssembly>true</SignAssembly>
