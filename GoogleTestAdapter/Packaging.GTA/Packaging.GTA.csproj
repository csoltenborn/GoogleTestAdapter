  <!-- The Google Test project and item templates. The wizard of the project template adds one of the Google Test NuGet
       packages to the new project; NuGet takes them from folder Packages of the VSIX (WizardData of the template).
       The packages are built by GoogleTestNuGet\Build.ps1 if they are missing (which takes a few minutes). -->
  <PropertyGroup>
    <TemplatesIntDir>$(IntermediateOutputPath)Templates\</TemplatesIntDir>
    <TemplateIcon>..\Resources\Icons\Icon.ico</TemplateIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectTemplateFile Include="..\ProjectTemplates\Test\GoogleTest\*" />
    <ItemTemplateFile Include="..\ItemTemplates\Test\GoogleTest\*" />
    <GoogleTestNuGetPackage Include="..\Packages\Microsoft.googletest.v140.windesktop.msvcstl.dyn.rt-dyn.1.18.0.nupkg" />
    <GoogleTestNuGetPackage Include="..\Packages\Microsoft.googletest.v140.windesktop.msvcstl.static.rt-dyn.1.18.0.nupkg" />
    <GoogleTestNuGetPackage Include="..\Packages\Microsoft.googletest.v140.windesktop.msvcstl.static.rt-static.1.18.0.nupkg" />
    <Content Include="$(TemplatesIntDir)GoogleTestPT.zip">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ProjectTemplates\Test</VSIXSubPath>
    </Content>
    <Content Include="$(TemplatesIntDir)GoogleTestIT.zip">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ItemTemplates\Test</VSIXSubPath>
    </Content>
    <Content Include="@(GoogleTestNuGetPackage)">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Packages</VSIXSubPath>
    </Content>
  </ItemGroup>
  <Target Name="BuildGoogleTestNuGetPackages" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_MissingGoogleTestNuGetPackage Include="@(GoogleTestNuGetPackage)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Exec Condition="'@(_MissingGoogleTestNuGetPackage)' != ''"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File Build.ps1 -VSPath &quot;$(VsInstallRoot.TrimEnd('\'))&quot;"
          WorkingDirectory="$(EnlistmentRoot)GoogleTestNuGet" />
  </Target>
  <Target Name="CreateTemplateArchives" BeforeTargets="PrepareForBuild"
          Inputs="@(ProjectTemplateFile);@(ItemTemplateFile);$(TemplateIcon)"
          Outputs="$(TemplatesIntDir)GoogleTestPT.zip;$(TemplatesIntDir)GoogleTestIT.zip">
    <RemoveDir Directories="$(TemplatesIntDir)ProjectTemplate;$(TemplatesIntDir)ItemTemplate" />
    <Copy SourceFiles="@(ProjectTemplateFile);$(TemplateIcon)" DestinationFolder="$(TemplatesIntDir)ProjectTemplate" />
    <Copy SourceFiles="@(ItemTemplateFile);$(TemplateIcon)" DestinationFolder="$(TemplatesIntDir)ItemTemplate" />
    <ZipDirectory SourceDirectory="$(TemplatesIntDir)ProjectTemplate" DestinationFile="$(TemplatesIntDir)GoogleTestPT.zip" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(TemplatesIntDir)ItemTemplate" DestinationFile="$(TemplatesIntDir)GoogleTestIT.zip" Overwrite="true" />
  </Target>
  <ItemGroup>
    <Content Include="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\gtest-logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\gtest-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Preview.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GoogleTestAdapter.VsPackage.GTA.pkgdef">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEvent>echo At least one file is needed within the lib/native folder to convince VS that our package can be installed into native C++ projects. &gt;"$(TargetDir)_.txt"

$(NuGetPackages)NuGet.CommandLine.7.9.0\tools\nuget pack VsPackage.nuspec -NonInteractive</PostBuildEvent>
  </PropertyGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
  <Import Project="$(VSSDKBuildToolsDir)Microsoft.VSSDK.BuildTools.targets" Condition="Exists('$(VSSDKBuildToolsDir)Microsoft.VSSDK.BuildTools.targets')" />
  <Target Name="EnsureVSSDKBuildTools" BeforeTargets="PrepareForBuild">
